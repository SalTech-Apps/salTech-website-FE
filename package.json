{
	"name": "saltech-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"dev": "PORT=8080 react-router dev",
		"build": "react-router build",
		"openapi:print": "node --experimental-strip-types -e \"import('./express/openapi/document.ts').then(({ openApiDocument }) => console.log(JSON.stringify(openApiDocument, null, 2)))\"",
		"start": "pnpm run build && NODE_ENV=production PORT=8080 node --experimental-strip-types ./server.ts",
		"start:dev": "NODE_ENV=development PORT=8081 node --watch --experimental-strip-types ./server.ts",
		"preview": "vite preview",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"typecheck": "react-router typegen && tsc -b",
		"optimize:public-assets": "node scripts/optimize-public-assets.mjs",
		"seed:admin": "node scripts/seed-default-admin.mjs",
		"seed:insights": "node scripts/seed-insights.mjs",
		"openapi:json": "mkdir -p openapi && node --experimental-strip-types -e \"import('./express/openapi/document.ts').then(({ openApiDocument }) => console.log(JSON.stringify(openApiDocument, null, 2)))\" > openapi/openapi.json",
		"openapi-ts": "pnpm run openapi:json && openapi-ts"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.5.0",
		"@azure/storage-blob": "^12.31.0",
		"@digicroz/react-floating-whatsapp": "^1.0.2",
		"@fingerprintjs/fingerprintjs": "^5.1.0",
		"@heroui/react": "^3.0.3",
		"@heroui/styles": "^3.0.3",
		"@hookform/resolvers": "^5.2.2",
		"@mjackson/node-fetch-server": "^0.2.0",
		"@react-router/express": "^7.13.0",
		"@react-router/node": "7.14.0",
		"@react-router/serve": "7.14.0",
		"@tailwindcss/vite": "^4.1.17",
		"@tanstack/react-query": "^5.99.2",
		"@toast-ui/editor": "^3.2.2",
		"@toast-ui/react-editor": "^3.2.2",
		"@types/swagger-ui-express": "^4.1.8",
		"@vercel/react-router": "^1.2.6",
		"axios": "^1.13.2",
		"compression": "^1.8.1",
		"date-fns": "^4.1.0",
		"express": "^5.1.0",
		"firebase": "^12.12.1",
		"firebase-admin": "^13.0.0",
		"framer-motion": "^12.38.0",
		"isbot": "^5.1.36",
		"jotai": "^2.18.0",
		"jspdf": "^4.2.1",
		"morgan": "^1.10.1",
		"multer": "^2.0.2",
		"next-themes": "^0.4.6",
		"nprogress": "^0.2.0",
		"photoswipe": "^5.4.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-hook-form": "^7.73.1",
		"react-hot-toast": "^2.6.0",
		"react-icons": "^5.6.0",
		"react-markdown": "^9.0.1",
		"react-photoswipe-gallery": "^4.0.0",
		"react-player": "^3.4.0",
		"react-router": "7.14.0",
		"react-router-dom": "^7.14.2",
		"recharts": "^3.6.0",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"sharp": "^0.34.5",
		"swagger-ui-express": "^5.0.1",
		"swiper": "^12.1.2",
		"tailwindcss": "^4.1.17",
		"xlsx": "^0.18.5",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@hey-api/openapi-ts": "0.97.0",
		"@hey-api/vite-plugin": "0.3.1",
		"@react-router/dev": "7.14.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^22",
		"@types/nprogress": "^0.2.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"dotenv": "^17.3.1",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^8.0.3"
	}
}
